{
  "Statement": [
    {
      "Sid": "AppBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::<ENV>-private",
        "arn:aws:s3:::<ENV>-private/*",
        "arn:aws:s3:::<ENV>-public",
        "arn:aws:s3:::<ENV>-public/*"
      ]
    }
  ]
}
