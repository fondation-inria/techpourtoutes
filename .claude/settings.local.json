{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(uv run *)",
      "Bash(uv sync)",
      "Bash(uv lock)",
      "Bash(uv pip list)",
      "Bash(uv run python manage.py check)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run python manage.py showmigrations *)",
      "Bash(uv run python manage.py makemigrations *)",
      "Bash(uv run python manage.py migrate *)",
      "Bash(make sync *)",
      "Bash(uv run python manage.py collectstatic *)",
      "Bash(uv run python manage.py test *)",
      "Bash(make test *)",
      "Bash(make run *)",
      "Bash(make lint *)",
      "Bash(make format *)",
      "Bash(make pre-commit *)",
      "Bash(uv run python manage.py show_urls)",
      "Bash(uv run python manage.py graph_models *)",
      "Bash(uv run python manage.py validate_templates)",
      "Bash(uv run python manage.py diffsettings)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Read(**/.env.example)",
      "Read(.env.example)",
      "WebFetch(domain:developers.brevo.com)",
      "WebFetch(domain:doc.scalingo.com)",
      "WebFetch(domain:developers.scalingo.com)",
      "Bash(git ls-tree *)",
      "Bash(awk '{print $4}')",
      "Bash(awk '{print $1, $3, $4}')",
      "Bash(sort -k3)",
      "mcp__plugin_context7_context7__query-docs"
    ],
    "deny": [
      "Bash(uv run python manage.py flush *)",
      "Bash(uv run python manage.py reset_db *)",
      "Bash(uv run python manage.py dumpdata *)",
      "Bash(uv run python manage.py loaddata *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Read(.env)",
      "Read(**/.env)",
      "Edit(.env)",
      "Read(*/faveod_users.csv)",
      "Read(**/faveod_users.csv)",
      "Edit(*/faveod_users.csv)",
      "Edit(**/faveod_users.csv)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/.claude/hooks/derived_permissions.py"

          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/write_and_edit_with_native_tools.py"
          }
        ]
      }
    ]
  }
}
